# registry.toml.example — source registry schema (committed reference).
#
# Copy to `registry.toml` (git-ignored) and fill in your real targets. One
# [[source]] table per ATS board. Loaded and validated by job_agent.registry;
# malformed config fails loud before any fetch. Inline `#` comments are fine.
#
# Fields:
#   vendor   (required)  one of: greenhouse | lever | workday | icims | talemetry
#   slug     (greenhouse/lever)  the board slug
#   tenant   (workday/icims)     the tenant
#   site     (workday)           the Workday site
#   host     (workday: required wd5/wd1; icims: optional custom domain)
#   name     (optional)  display company name (see note)
#   enabled  (optional, default true)  set false to disable without deleting
#   max_per_employer (optional, int)  deprecated; accepted but ignored
#                                     (per-source fetch is now bounded by the
#                                     JOBAGENT_MAX_DETAIL_PER_SOURCE /
#                                     JOBAGENT_FETCH_DEADLINE_SECONDS backstop)
#
# Note: `name` is the authoritative digest company. The loader resolves it
# (name if set, else the slug for greenhouse/lever or the tenant for
# workday/icims) and fetch passes it to the adapter. Set `name` to the
# source's current effective company so dedupe fingerprints stay stable.

# --- Greenhouse: boards-api.greenhouse.io/v1/boards/{slug} ---
[[source]]
vendor = "greenhouse"
slug   = "initech"

# --- Lever: api.lever.co/v0/postings/{slug} ---
[[source]]
vendor = "lever"
slug   = "example-co"

# --- Workday: {tenant}.{host}.myworkdayjobs.com/wday/cxs/{tenant}/{site} ---
# Read tenant/site/host off the careers URL. Slug traps are common: the tenant
# often differs from the brand name, and host is wd1 vs wd5 per tenant.
[[source]]
vendor = "workday"
name   = "Globex Corporation"
tenant = "globex"
site   = "Globex"
host   = "wd5"

# --- iCIMS (Jibe): https://{host}/api/jobs ; host defaults to {tenant}.icims.com ---
[[source]]
vendor = "icims"
tenant = "hooli"
host   = "careers.hooli.com"
# enabled = false

# --- Talemetry / TTC-Portals: https://{host}/jobs/ (HTML scrape) ---
[[source]]
vendor = "talemetry"
name   = "Example Co"
host   = "careers.example.com"
